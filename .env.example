# ==============================================================================
# @atengk/mcp-server-s3 环境变量配置模板 (.env.example)
# 复制此文件为 .env 并在本地进行个性化配置: cp .env.example .env
# 配置优先级: 命令行参数 (CLI Flags) > MCP_S3_* > AWS_* > 内部默认值
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心 S3 连接与凭据配置 (Core Connection & Credentials)
# ------------------------------------------------------------------------------

# S3 兼容服务端接入点 URL (私有云/MinIO/RustFS 必填，原生 AWS S3 可留空由 Region 推导)
# 示例: http://127.0.0.1:9000 或 https://oss-cn-hangzhou.aliyuncs.com
MCP_S3_ENDPOINT=http://127.0.0.1:9000

# 目标物理部署地域 (MinIO/RustFS/R2 通常设为 us-east-1 或 auto)
MCP_S3_REGION=us-east-1

# S3 访问密钥 ID (Access Key ID)
MCP_S3_ACCESS_KEY_ID=your_access_key_id

# S3 访问密钥 Secret (Secret Access Key)
MCP_S3_SECRET_ACCESS_KEY=your_secret_access_key

# STS 临时会话令牌 (Session Token, 仅使用临时联合身份或 IAM 角色扮演时可选配置)
# MCP_S3_SESSION_TOKEN=

# 寻址风格: 是否强制使用路径寻址 (Path-Style)
# 自建 MinIO / RustFS 务必设为 true；AWS S3 / 阿里云 OSS / 腾讯云 COS 通常设为 false
MCP_S3_FORCE_PATH_STYLE=true

# 默认绑定存储桶名称 (配置后各工具的 bucket 参数自动转为可选，默认指向该桶)
MCP_S3_DEFAULT_BUCKET=dev-bucket


# ------------------------------------------------------------------------------
# 2. 安全门禁与防灾参数 (Security Guardrails)
# ------------------------------------------------------------------------------

# 只读门禁模式: 为 true 时在协议层物理隐藏所有写/删类高危工具，100% 杜绝 AI 误操作
MCP_S3_READ_ONLY=false

# 本地工作区沙箱基准目录: 严格限制 upload_file / download_file 仅能在该目录内交互
# 阻断任何绝对路径逃逸或包含 ../ 的路径遍历尝试
MCP_S3_ALLOWED_LOCAL_DIR=./

# 纯文本读取最大安全体积阈值 (单位: 字节, 默认: 262144 即 256KB)
# 超过此阈值的大文件读取将被安全截断并注入警告，防止撑爆大模型上下文窗口
MCP_S3_MAX_READ_BYTES=262144

# 预签名直链 (Presigned URL) 默认有效生命周期 (单位: 秒, 默认: 3600 即 1小时)
MCP_S3_PRESIGNED_EXPIRES=3600


# ------------------------------------------------------------------------------
# 3. 双模通信传输与网络服务 (Transport & Networking)
# ------------------------------------------------------------------------------

# 通信传输模式: stdio (本地标准输入输出管道, 桌面端推荐) 或 sse (HTTP 远程长轮询)
MCP_S3_TRANSPORT=stdio

# HTTP SSE 服务监听的主机地址 (仅在 MCP_S3_TRANSPORT=sse 时生效)
MCP_S3_SERVER_HOST=0.0.0.0

# HTTP SSE 服务监听的端口号 (仅在 MCP_S3_TRANSPORT=sse 时生效)
MCP_S3_SERVER_PORT=8000

# HTTP SSE 远程访问鉴权 Token (Bearer Token, 可选)
# 若配置，外部调用 /sse 与 /message 必须在请求头携带 Authorization: Bearer <token> 或 ?token=<token>
# MCP_S3_API_KEY=your-secret-access-token
